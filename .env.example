# Скопіюйте цей файл у .env і вставте свої значення.
# Реальні значення зберігаються тільки в .env — він не потрапляє в Git.

# Токен бота від @BotFather
BOT_TOKEN=your-telegram-bot-token

# Рядок підключення до бази Neon PostgreSQL:
# Neon Console -> ваш проєкт -> Connect -> Connection string.
# Він починається з postgresql:// і містить логін і пароль бази — це секрет.
DATABASE_URL=your-neon-connection-string

# Пароль входу в web-адмінку (щонайменше 8 символів). Отримує лише сервіс api.
# Придумайте власний; без нього адмінка не пускає нікого.
ADMIN_PASSWORD=your-admin-password
